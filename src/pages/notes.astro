---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---
<BaseLayout title={`Публикации — ${siteConfig.name}`} description="Технические заметки ONLY.">
  <div class="container page-intro"><p class="eyebrow">Notes / Lab</p><h1>Публикации</h1><p class="lead">Здесь появятся инструкции, разборы и технические заметки. Пока опубликованных материалов нет.</p></div>
  <section class="section"><div class="container"><div class="empty-state">Пустая секция намеренно: фиктивные статьи не создаются.</div></div></section>
</BaseLayout>
