---
import BaseLayout from '../layouts/BaseLayout.astro';
import OnlyVisual from '../components/OnlyVisual.astro';
import { siteConfig, projects, focusAreas, technologies } from '../data/site';
---
<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="hero"><div class="container hero-grid"><div><p class="eyebrow">Independent developer / {siteConfig.handle}</p><h1>Digital tools<br /><span style="color:var(--accent)">that work.</span></h1><p class="lead">{siteConfig.tagline} Разработка, искусственный интеллект, автоматизация и цифровая приватность.</p><div class="actions"><a class="button button-primary" href="/projects">Смотреть проекты</a><a class="button button-secondary" href="/contact">Связаться</a></div></div><div class="hero-visual"><picture><source srcset="/images/only-personal-avatar.webp" type="image/webp" /><img class="avatar" src={siteConfig.avatar} width="1254" height="1254" fetchpriority="high" decoding="async" alt="Персональный иллюстрированный аватар ONLY: персонаж с длинными синими волосами и белой птицей на тёмном фоне" /></picture></div></div></section>
  <section class="section visual-section"><div class="container visual-layout"><div><p class="eyebrow">Digital space</p><h2>Проект как пространство.</h2><p class="lead">ONLY — это не только набор страниц, а собранная вокруг задач цифровая среда.</p></div><OnlyVisual variant="space" /></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Selected work</p><h2>Публичные проекты</h2></div><p>Реальные разработки и документация, доступные без авторизации.</p></div><div class="grid-3">{projects.filter(p => p.featured).map((project) => <article class="card project-card"><span class="card-kicker">{project.category}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.technologies.map(t => <span class="tag">{t}</span>)}</div><div class="card-footer"><span class="link-meta">{project.status}</span><a href={`/projects/${project.slug}`}>Подробнее →</a></div></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Focus areas</p><h2>Направления</h2></div></div><div class="grid-2">{focusAreas.map((area) => <article class="card"><span class="number">{area.number}</span><h3>{area.title}</h3><p>{area.text}</p></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Toolkit</p><h2>Технологии</h2></div></div><div class="tags">{technologies.map(t => <span class="tag">{t}</span>)}</div></div></section>
  <section class="section"><div class="container"><div class="card" style="display:flex;justify-content:space-between;gap:24px;align-items:center;flex-wrap:wrap"><div><p class="eyebrow">Open channel</p><h2 style="margin-bottom:8px">Есть задача?</h2><p style="margin:0;color:var(--text-2)">Открыт к предметным разговорам о разработке и цифровых инструментах.</p></div><a class="button button-primary" href="/contact">Контакты →</a></div></div></section>
</BaseLayout>
