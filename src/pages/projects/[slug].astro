---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, siteConfig } from '../../data/site';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — ${siteConfig.name}`} description={project.description}>
  <div class="container page-intro"><p class="eyebrow">{project.category} / {project.status}</p><h1>{project.title}</h1><p class="lead">{project.description}</p><div class="actions"><a class="button button-primary" href={project.github} target="_blank" rel="noopener noreferrer">Открыть GitHub ↗</a><a class="button button-secondary" href="/projects">Все проекты</a></div></div>
  <section class="section"><div class="container project-showcase">{project.previewKind === 'image' ? <figure class="project-hero-preview"><img src={project.preview} alt={project.previewAlt} width="1200" height="675" /><figcaption>{project.previewNote}</figcaption></figure> : <div class="project-hero-preview project-device-preview project-device-preview-large"><span>{project.previewLabel}</span><small>{project.previewMeta}</small><i></i><p>{project.previewNote}</p></div>}</div></section>
  <section class="section"><div class="container project-detail-grid"><div><p class="eyebrow">Problem</p><h2>Что решает проект</h2></div><div class="prose"><p>{project.problem}</p></div></div></section>
  <section class="section"><div class="container project-detail-grid"><div><p class="eyebrow">Functionality</p><h2>Что внутри</h2></div><div class="detail-list">{project.functionality.map((item, index) => <div class="detail-item"><span class="number">0{index + 1}</span><span>{item}</span></div>)}</div></div></section>
  <section class="section"><div class="container grid-2"><div><p class="eyebrow">Technology</p><div class="tags">{project.technologies.map(t => <span class="tag">{t}</span>)}</div></div><div class="card"><p class="eyebrow">Known limitations</p><p>{project.limitations}</p></div></div></section>
</BaseLayout>
