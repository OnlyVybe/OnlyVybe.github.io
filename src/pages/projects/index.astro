---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, siteConfig } from '../../data/site';
const categories = ['Все', ...new Set(projects.map((project) => project.category))];
const categoryDescriptions: Record<string, string> = {
  'Все': 'Все подтвержденные публичные проекты.',
  'Smart TV': 'Инструменты и документация для телевизионных платформ.',
  Privacy: 'Практические настройки приватности и контроля телеметрии.'
};
---
<BaseLayout title={`Проекты — ${siteConfig.name}`} description="Публичные проекты ONLY: инструменты, документация и исследования.">
  <div class="container page-intro"><p class="eyebrow">Selected work</p><h1>Проекты</h1><p class="lead">Портфолио состоит только из материалов, которые доступны публично и могут быть проверены посетителем.</p></div>
  <section class="section"><div class="container">
    <div class="filter-bar" role="group" aria-label="Фильтр проектов по категории">{categories.map((category, index) => <button class="filter-button" type="button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}</div>
    <p class="filter-description" id="filter-description">{categoryDescriptions['Все']}</p>
    <p class="sr-only" id="project-count" aria-live="polite">Показано проектов: {projects.length}</p>
    <div class="grid-3" id="project-list">{projects.map((project) => <article class="card project-card" data-category={project.category}><span class="card-kicker">{project.category}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.technologies.map(t => <span class="tag">{t}</span>)}</div><div class="card-footer"><a href={`/projects/${project.slug}`}>Подробнее →</a><a href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub проекта ${project.title}`}>GitHub ↗</a></div></article>)}</div>
  </div></section>
  <script>
    const descriptions = { 'Все': 'Все подтвержденные публичные проекты.', 'Smart TV': 'Инструменты и документация для телевизионных платформ.', 'Privacy': 'Практические настройки приватности и контроля телеметрии.' };
    const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter-button')];
    const cards = [...document.querySelectorAll<HTMLElement>('.project-card[data-category]')];
    const count = document.getElementById('project-count');
    const description = document.getElementById('filter-description');
    filters.forEach((filter) => filter.addEventListener('click', () => {
      const value = filter.dataset.filter || 'Все';
      filters.forEach((button) => button.setAttribute('aria-pressed', String(button === filter)));
      let visible = 0;
      cards.forEach((card) => { const show = value === 'Все' || card.dataset.category === value; card.hidden = !show; if (show) visible += 1; });
      if (count) count.textContent = `Показано проектов: ${visible}`;
      if (description) description.textContent = descriptions[value as keyof typeof descriptions] || '';
    }));
  </script>
</BaseLayout>
