---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, socialLinks } from '../data/site';
const iconLabels: Record<string, string> = { github: 'GH', telegram: 'TG', vk: 'VK' };
---
<BaseLayout title={`Контакты — ${siteConfig.name}`} description="Контактная информация ONLY.">
  <div class="container page-intro"><p class="eyebrow">Open channel</p><h1>Контакты</h1><p class="lead">Публичные каналы для вопросов по проектам, документации и цифровым инструментам.</p></div>
  <section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Channels</p><h2>Где меня найти</h2></div><p>GitHub уже доступен. Telegram и ВКонтакте подготовлены как заглушки — ссылки появятся позднее.</p></div><div class="grid-3 contact-grid">{socialLinks.map(channel => channel.available ? <a class="card contact-card contact-link" href={channel.href} target="_blank" rel="noopener noreferrer"><span class={`social-icon social-${channel.icon}`}>{iconLabels[channel.icon]}</span><span class="status-pill status-live">Доступен</span><h3>{channel.label}</h3><p>Публичные проекты и обратная связь по документации.</p><span class="contact-action">Открыть канал ↗</span></a> : <article class="card contact-card contact-placeholder" aria-label={`${channel.label}: ссылка будет добавлена позже`}><span class={`social-icon social-${channel.icon}`}>{iconLabels[channel.icon]}</span><span class="status-pill">Скоро</span><h3>{channel.label}</h3><p>Канал подготовлен. Адрес будет добавлен после публикации официальной ссылки.</p><span class="contact-action">Ссылка появится позже</span></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="card contact-note"><div><p class="eyebrow">Перед сообщением</p><h2>Сделайте вопрос конкретным.</h2></div><p>Укажите проект, модель устройства, версию окружения, шаги воспроизведения и ожидаемый результат. Не отправляйте секреты, токены или персональные данные.</p></div></div></section>
</BaseLayout>
