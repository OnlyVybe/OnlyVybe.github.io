---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, projects } from '../data/site';
const links = [
  { label: 'GitHub OnlyVybe', meta: 'Все публичные разработки', href: 'https://github.com/OnlyVybe', icon: 'GH' },
  ...projects.map((project) => ({ label: project.title, meta: 'Открытый репозиторий проекта', href: project.github, icon: '↗' }))
];
---
<BaseLayout title={`Ссылки — ${siteConfig.name}`} description="Публичный профиль и открытые репозитории ONLY.">
  <div class="container page-intro"><p class="eyebrow">Public channels</p><h1>Ссылки</h1><p class="lead">GitHub-профиль и все три открытых репозитория — в одном месте.</p></div>
  <section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Разработка и технологии</p><h2>Открытые ресурсы</h2></div><p>Каждая карточка ведёт прямо на соответствующую страницу GitHub.</p></div><div class="link-groups">{links.map(link => <a class="link-row" href={link.href} target="_blank" rel="noopener noreferrer"><span class="social-icon social-github" aria-hidden="true">{link.icon}</span><span class="link-copy"><strong>{link.label}</strong><span class="link-meta">{link.meta}</span></span><span class="link-arrow" aria-hidden="true">Открыть ↗</span></a>)}</div></div></section>
</BaseLayout>
