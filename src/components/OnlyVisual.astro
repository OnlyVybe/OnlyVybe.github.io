---
const { variant = 'space' } = Astro.props;
---
{variant === 'identity' ? (
  <div class="brand-3d brand-3d-identity" aria-label="Архитектурная объёмная композиция бренда ONLY">
    <div class="identity-horizon" aria-hidden="true"></div>
    <div class="identity-light identity-light-one" aria-hidden="true"></div>
    <div class="identity-light identity-light-two" aria-hidden="true"></div>
    <div class="identity-pillar pillar-left" aria-hidden="true"><span></span></div>
    <div class="identity-pillar pillar-right" aria-hidden="true"><span></span></div>
    <div class="identity-sculpture" aria-hidden="true">
      <div class="identity-slab slab-top"></div>
      <div class="identity-monogram"><span>O</span><span>N</span><span>L</span><span>Y</span></div>
      <div class="identity-plinth"><i></i><b>ONLY</b><i></i></div>
      <div class="identity-shadow"></div>
    </div>
    <div class="identity-coordinate coordinate-left" aria-hidden="true">X 04.7<br />Y 19.2</div>
    <div class="identity-coordinate coordinate-right" aria-hidden="true">OBJECT<br />№ 01</div>
    <div class="brand-3d-caption">IDENTITY / MONUMENT</div>
  </div>
) : (
  <div class="space-3d" aria-label="Цифровое пространство проекта ONLY">
    <div class="space-3d-stars" aria-hidden="true"></div>
    <div class="space-3d-grid" aria-hidden="true"></div>
    <div class="space-3d-orbit space-3d-orbit-one" aria-hidden="true"></div>
    <div class="space-3d-orbit space-3d-orbit-two" aria-hidden="true"></div>
    <div class="space-3d-panel panel-code" aria-hidden="true"><b>01</b><span>SYSTEM</span><i></i><i></i><i></i></div>
    <div class="space-3d-panel panel-data" aria-hidden="true"><span>DATA</span><b>◌</b></div>
    <div class="space-3d-node node-one" aria-hidden="true"></div>
    <div class="space-3d-node node-two" aria-hidden="true"></div>
    <div class="space-3d-node node-three" aria-hidden="true"></div>
    <div class="space-3d-core" aria-hidden="true"><span>O</span><small>ONLY</small></div>
    <div class="space-3d-label">ONLY / DIGITAL SPACE</div>
    <div class="space-3d-status">SYSTEM ONLINE <i></i></div>
  </div>
)}
